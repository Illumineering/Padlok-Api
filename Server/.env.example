# Copy to .env for local runs. The process environment wins over this file.
# In production, the same variables come from /etc/padlok/<environment>.env via
# supervisor.

PADLOK_HOST=127.0.0.1
PADLOK_PORT=8080
# trace, debug, info, notice, warning, error, critical
PADLOK_LOG_LEVEL=debug

# The MariaDB from compose.yaml.
PADLOK_DB_HOST=127.0.0.1
PADLOK_DB_PORT=3308
PADLOK_DB_NAME=padlok
PADLOK_DB_USER=padlok
PADLOK_DB_PASSWORD=padlok

# Browser origins allowed to call the API, as a regular expression on the whole Origin.
PADLOK_CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
